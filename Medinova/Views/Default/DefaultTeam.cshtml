@model  IEnumerable<Medinova.Models.Doctors>

<div class="container-fluid py-5">
    <div class="container">

        <div class="text-center mx-auto mb-5" style="max-width: 500px;">
            <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5">
                Ekibimiz
            </h5>
            <h1 class="display-4">Uzman Sağlık Profesyonelleri</h1>
        </div>

        <div class="owl-carousel team-carousel position-relative">
            @foreach (var item in Model)
            {

           
            <div class="team-item">
                <div class="row g-0 bg-light rounded overflow-hidden">

                    <div class="col-sm-5">
                        <img class="img-fluid h-100" src="@item.ImageUrl" style="object-fit: cover;">
                    </div>

                    <div class="col-sm-7 d-flex flex-column">

                        <div class="mt-auto p-4">
                            <h3>@item.FullName</h3>
                            <h6 class="fst-italic text-primary mb-3">@item.Description</h6>
                            <p>@item.Title</p>
                        </div>

                        <div class="d-flex border-top p-4">
                            <a class="btn btn-primary rounded-circle me-2"><i class="fab fa-twitter"></i></a>
                            <a class="btn btn-primary rounded-circle me-2"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-primary rounded-circle"><i class="fab fa-linkedin-in"></i></a>
                        </div>

                    </div>

                </div>
            </div>
            }
        </div>
    </div>
</div>